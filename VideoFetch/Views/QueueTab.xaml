<UserControl x:Class="VideoFetch.Views.QueueTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:VideoFetch.Models"
             xmlns:conv="clr-namespace:VideoFetch.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
        <conv:StateToColorConverter x:Key="StateToColor"/>
        <conv:EnumEqualsConverter x:Key="EnumEquals"/>
        <conv:IntGreaterThanZeroConverter x:Key="IntGtZero"/>

        <!-- 迅雷式分类药丸 -->
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="12" Padding="11,4"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter pills + actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterPill}" GroupName="QueueFilter" Content="{Binding FilterAllText}"
                             IsChecked="{Binding QueueFilter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:QueueFilter.All}}"/>
                <RadioButton Style="{StaticResource FilterPill}" GroupName="QueueFilter" Content="{Binding FilterDownloadingText}"
                             IsChecked="{Binding QueueFilter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:QueueFilter.Downloading}}"/>
                <RadioButton Style="{StaticResource FilterPill}" GroupName="QueueFilter" Content="{Binding FilterCompletedText}"
                             IsChecked="{Binding QueueFilter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:QueueFilter.Completed}}"/>
                <RadioButton Style="{StaticResource FilterPill}" GroupName="QueueFilter" Content="{Binding FilterFailedText}"
                             IsChecked="{Binding QueueFilter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:QueueFilter.Failed}}"/>
                <RadioButton Style="{StaticResource FilterPill}" GroupName="QueueFilter" Content="{Binding FilterDeletedText}"
                             IsChecked="{Binding QueueFilter, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:QueueFilter.Deleted}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Btn_RetryAll}"
                        Command="{Binding RetryAllFailedCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3"
                        Margin="0,0,8,0"
                        ToolTip="{DynamicResource Tip_RetryAll}"
                        Visibility="{Binding FailedCount, Converter={StaticResource IntGtZero}}"/>
                <Button Content="{DynamicResource Btn_CancelAll}"
                        Command="{Binding CancelAllDownloadsCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="8,3"
                        Margin="0,0,8,0"
                        Visibility="{Binding ActiveCount, Converter={StaticResource IntGtZero}}"/>
                <Button Content="{DynamicResource Btn_EmptyTrash}"
                        Command="{Binding EmptyTrashCommand}"
                        Style="{StaticResource DangerButtonStyle}" Padding="8,3"
                        Visibility="{Binding TrashCount, Converter={StaticResource IntGtZero}}"/>
                <Button Content="{DynamicResource Btn_OpenFolder}"
                        Command="{Binding OpenOutputFolderCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0" Padding="8,3"/>
            </StackPanel>
        </Grid>

        <!-- Download list -->
        <Grid Grid.Row="1">
            <ListView ItemsSource="{Binding QueueItemsView}"
                      Background="Transparent" BorderThickness="0"
                      ItemContainerStyle="{StaticResource FlatListViewItemStyle}"
                      MouseDoubleClick="QueueList_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <!-- 允许拖动表头换列顺序；列宽靠表头右边缘拖拽调整 -->
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="{DynamicResource Queue_Header_Title}" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Title}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Padding="6,4" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_Duration}" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="{Binding Duration}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_Size}" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <TextBlock Text="{Binding FileSizeText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_Progress}" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <ProgressBar Value="{Binding Progress}" Maximum="100"
                                                 Height="6" Width="80"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_Status}" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <StackPanel>
                                        <!-- Status text can be long ("Failed: Response status
                                             code does not indicate success…"), so ellipsize it
                                             and show the full text in a tooltip instead of
                                             clipping mid-glyph. -->
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Status}"
                                                   Foreground="{Binding State, Converter={StaticResource StateToColor}}"
                                                   Padding="6,2"/>
                                        <TextBlock Text="{Binding Speed}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Padding="6,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_DownloadTime}" Width="125">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <!-- 完成时间；还在排队/下载中显示入队时间 -->
                                    <TextBlock Text="{Binding DownloadTimeText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Queue_Header_Actions}" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <Grid>
                                        <!-- 正常任务：按状态给不同动作
                                             下载中 → 取消
                                             失败/取消 → 重试 + 删除任务
                                             已完成 → 删除任务 + 删除文件 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsInTrash, Converter={StaticResource InvertBoolToVis}}">
                                            <Button Content="{DynamicResource Btn_CancelDownload}"
                                                    Command="{Binding DataContext.CancelDownloadCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="10" Padding="5,2"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{DynamicResource Btn_RetryTask}"
                                                    Command="{Binding DataContext.RetryTaskCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="10" Padding="5,2"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{DynamicResource Btn_DeleteTask}"
                                                    Command="{Binding DataContext.DeleteTaskCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="4,0,0,0"
                                                    FontSize="10" Padding="5,2"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{DynamicResource Btn_DeleteLocalFile}"
                                                    Command="{Binding DataContext.DeleteLocalFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Margin="4,0,0,0"
                                                    FontSize="10" Padding="5,2"
                                                    Visibility="{Binding CanDeleteFile, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- 回收站：恢复 / 彻底删除 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding IsInTrash, Converter={StaticResource BoolToVis}}">
                                            <Button Content="{DynamicResource Btn_RestoreTask}"
                                                    Command="{Binding DataContext.RestoreTaskCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="10" Padding="5,2"
                                                    Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{DynamicResource Btn_PurgeTask}"
                                                    Command="{Binding DataContext.PurgeTaskCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Margin="4,0,0,0"
                                                    FontSize="10" Padding="5,2"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Empty state (follows the selected category) -->
            <Border Background="Transparent"
                    Visibility="{Binding IsCurrentViewEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding QueueEmptyText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
