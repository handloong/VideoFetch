<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════
         中文语言包 (zh-CN) - 默认语言
         ═══════════════════════════════════════════════════ -->

    <!-- ── 窗口标题 / Header ──────────────────────── -->
    <sys:String x:Key="AppTitle">VideoFetch - 视频下载工具</sys:String>
    <sys:String x:Key="HeaderTitle">VideoFetch</sys:String>

    <!-- Tab names -->
    <sys:String x:Key="Tab_Download">📥 下载</sys:String>
    <sys:String x:Key="Tab_Search">🔍 搜索</sys:String>
    <sys:String x:Key="Tab_Queue">⏳ 下载</sys:String>
    <sys:String x:Key="Tab_Settings">⚙ 设置</sys:String>

    <!-- ── Download tab ─────────────────────────────── -->
    <sys:String x:Key="UrlPlaceholder">粘贴视频链接 (PornHub / XVideos / XNXX)... 按 Ctrl+V 快速粘贴</sys:String>
    <sys:String x:Key="Btn_PasteUrl">📋 粘贴并获取</sys:String>
    <sys:String x:Key="Btn_FetchInfo">🔍 获取视频信息</sys:String>
    <sys:String x:Key="Label_VideoTitle">视频标题</sys:String>
    <sys:String x:Key="Label_Author">作者</sys:String>
    <sys:String x:Key="Label_Duration">时长</sys:String>
    <sys:String x:Key="Label_QualitySelect">选择画质</sys:String>
    <sys:String x:Key="Btn_Download">⬇ 开始下载</sys:String>
    <sys:String x:Key="Status_Fetching">正在获取视频信息...</sys:String>
    <sys:String x:Key="Status_AddedToQueue">已加入队列：</sys:String>
    <sys:String x:Key="Error_UnsupportedURL">不支持的链接。支持：PornHub、xvideos、xnxx</sys:String>
    <sys:String x:Key="Label_OutputFolder">保存目录：</sys:String>
    <sys:String x:Key="Btn_BrowseFolder">浏览...</sys:String>
    <sys:String x:Key="Tip_ClickHeaderToSort">点击表头切换排序</sys:String>
    <sys:String x:Key="Queue_SortFormat">{0} {1}</sys:String>
    <sys:String x:Key="Btn_DeleteFiles">🗑 删除文件 ({0})</sys:String>
    <sys:String x:Key="Tip_DeleteFiles">删除选中任务已下载的本地文件（任务记录保留）</sys:String>
    <sys:String x:Key="Confirm_DeleteFiles">确定删除选中的 {0} 个本地文件吗？&#10;文件会被直接删除，无法恢复。</sys:String>
    <sys:String x:Key="Confirm_DeleteFiles_Title">删除本地文件</sys:String>
    <sys:String x:Key="Btn_OpenFolder">打开文件夹</sys:String>

    <!-- ── Search tab ───────────────────────────────── -->
    <sys:String x:Key="Search_Placeholder">输入关键词搜索...</sys:String>
    <sys:String x:Key="Btn_Search">🔍 搜索</sys:String>
    <sys:String x:Key="Label_SiteSelect">搜索站点：</sys:String>

    <!-- Search results table headers -->
    <sys:String x:Key="Col_Index">序号</sys:String>
    <sys:String x:Key="Col_Checkbox">☐</sys:String>
    <sys:String x:Key="Col_Title">标题</sys:String>
    <sys:String x:Key="Col_Source">来源</sys:String>
    <sys:String x:Key="Col_Duration">时长</sys:String>
    <sys:String x:Key="Col_Download">操作</sys:String>

    <!-- 结果列表右键菜单 -->
    <sys:String x:Key="Menu_OpenSourceUrl">🔗 打开源网址</sys:String>

    <!-- 时长筛选（目前仅 91pinse 支持） -->
    <sys:String x:Key="Dur_Tooltip">按时长筛选（仅 91pinse 支持）</sys:String>
    <sys:String x:Key="Dur_All">全部时长</sys:String>
    <sys:String x:Key="Dur_Short">&lt; 5 分钟</sys:String>
    <sys:String x:Key="Dur_Medium">5-20 分钟</sys:String>
    <sys:String x:Key="Dur_Long">20+ 分钟</sys:String>
    <!-- 结果列表排序 -->
    <sys:String x:Key="Sort_Label">排序</sys:String>
    <sys:String x:Key="Sort_Default">默认顺序</sys:String>
    <sys:String x:Key="Sort_DurationDesc">时长 长→短</sys:String>
    <sys:String x:Key="Sort_DurationAsc">时长 短→长</sys:String>
    <sys:String x:Key="Sort_Tooltip">按视频时长重排当前列表（不会重新请求站点；解析不出时长的排最后）</sys:String>

    <!-- Category tab -->
    <sys:String x:Key="Tab_Category">🗂 分类</sys:String>
    <sys:String x:Key="Btn_LoadCategories">🔄 加载分类</sys:String>
    <sys:String x:Key="Cat_Loading">正在加载 {0} 分类...</sys:String>
    <sys:String x:Key="Cat_Loaded">{0}：共 {1} 个分类，点击标签浏览视频</sys:String>
    <sys:String x:Key="Cat_LoadFailed">在线分类解析失败，请检查网络或代理后重试（{0}）</sys:String>
    <sys:String x:Key="Cat_NoCategories">{0}：没有解析到分类，站点页面结构可能已变化</sys:String>
    <sys:String x:Key="Cat_Browsing">正在浏览分类「{0}」第 {1} 页...</sys:String>
    <sys:String x:Key="Cat_Browsed">分类「{0}」已加载 {1} 个视频</sys:String>
    <sys:String x:Key="Cat_NoResults">该分类没有解析到视频</sys:String>
    <sys:String x:Key="Cat_BrowseError">分类浏览失败: {0}</sys:String>
    <sys:String x:Key="Empty_CategoryResults">先选择站点并点击"加载分类"，然后点击分类标签浏览视频。双击行可预览缩略图。</sys:String>

    <!-- Batch actions -->
    <sys:String x:Key="Btn_SelectAll">☑ 全选</sys:String>
    <sys:String x:Key="Btn_InvertSelection">☐ 反选</sys:String>
    <sys:String x:Key="Btn_BatchDownload">⬇ 批量下载选中项 ({0})</sys:String>
    <sys:String x:Key="Hint_DoubleClick">双击行可预览缩略图（ESC关闭）</sys:String>
    <sys:String x:Key="Btn_DownloadRow">⬇ 下载</sys:String>
    <sys:String x:Key="Btn_LoadMore">加载更多结果...</sys:String>
    <sys:String x:Key="Btn_CancelBatch">✕ 取消批量</sys:String>
    <sys:String x:Key="Batch_Progress">正在准备 {0}/{1}：{2}</sys:String>
    <sys:String x:Key="Btn_IncludeDownloaded">包含已下载项</sys:String>
    <sys:String x:Key="Tip_IncludeDownloaded">勾选后，已下载过的视频也会被重新下载（类似迅雷强制重下载）</sys:String>

    <!-- Empty state -->
    <sys:String x:Key="Empty_SearchResults">在上方输入关键词并点击"搜索"来查找视频；也可以切换到"分类"标签页按分类浏览。</sys:String>

    <!-- Search status messages -->
    <sys:String x:Key="Status_Searching">正在 {0} 搜索「{1}」...</sys:String>
    <sys:String x:Key="Status_FoundResults">找到 {0} 条结果</sys:String>
    <sys:String x:Key="Status_NoResults">未找到结果，试试其他关键词。</sys:String>
    <sys:String x:Key="Status_SearchError">搜索错误：{0}</sys:String>
    <sys:String x:Key="Status_LoadingPage">正在加载第 {0} 页...</sys:String>
    <sys:String x:Key="Status_TotalResults">共加载 {0} 条结果</sys:String>
    <sys:String x:Key="Status_LoadingMoreError">加载更多出错：{0}</sys:String>
    <sys:String x:Key="Status_PreparingDownload">正在准备下载：{0}</sys:String>

    <!-- Queue tab -->
    <sys:String x:Key="Queue_Empty">暂无下载任务</sys:String>
    <sys:String x:Key="Queue_Empty_Active">没有正在下载的任务</sys:String>
    <sys:String x:Key="Queue_Empty_Completed">还没有已完成的下载</sys:String>
    <sys:String x:Key="Queue_Empty_Failed">没有失败的任务</sys:String>
    <sys:String x:Key="Queue_Empty_Trash">回收站是空的</sys:String>
    <sys:String x:Key="Queue_Filter_All">全部 ({0})</sys:String>
    <sys:String x:Key="Queue_Filter_Downloading">下载中 ({0})</sys:String>
    <sys:String x:Key="Queue_Filter_Completed">已完成 ({0})</sys:String>
    <sys:String x:Key="Queue_Filter_Failed">失败 ({0})</sys:String>
    <sys:String x:Key="Queue_Filter_Deleted">已删除 ({0})</sys:String>

    <!-- 下载任务状态（按 DownloadState 枚举本地化） -->
    <sys:String x:Key="State_Queued">等待中</sys:String>
    <sys:String x:Key="State_Downloading">下载中</sys:String>
    <sys:String x:Key="State_Completed">已完成</sys:String>
    <sys:String x:Key="State_Failed">失败</sys:String>
    <sys:String x:Key="State_Cancelled">已取消</sys:String>
    <sys:String x:Key="State_Cancelling">正在取消…</sys:String>
    <sys:String x:Key="State_Deleted">已删除</sys:String>
    <sys:String x:Key="State_FileMissing">文件已删除</sys:String>
    <sys:String x:Key="Queue_Header_Title">标题</sys:String>
    <sys:String x:Key="Queue_Header_Duration">时长</sys:String>
    <sys:String x:Key="Queue_Header_DownloadTime">下载时间</sys:String>
    <sys:String x:Key="Queue_Header_Size">大小</sys:String>
    <sys:String x:Key="Queue_Header_Progress">进度</sys:String>
    <sys:String x:Key="Queue_Header_Status">状态</sys:String>
    <sys:String x:Key="Queue_Header_Speed">速度</sys:String>
    <sys:String x:Key="Queue_Header_Actions">操作</sys:String>
    <sys:String x:Key="Btn_CancelDownload">取消</sys:String>
    <sys:String x:Key="Btn_RetryTask">重试</sys:String>
    <sys:String x:Key="Btn_DeleteTask">删除任务</sys:String>
    <sys:String x:Key="Btn_DeleteLocalFile">🗑 删除文件</sys:String>
    <sys:String x:Key="Btn_RestoreTask">恢复</sys:String>
    <sys:String x:Key="Btn_PurgeTask">彻底删除</sys:String>
    <sys:String x:Key="Btn_RetryAll">↻ 重试全部</sys:String>
    <sys:String x:Key="Tip_RetryAll">把所有失败/已取消的任务重新下载（已完成和回收站里的不动）</sys:String>
    <sys:String x:Key="Btn_CancelAll">⏹ 全部取消</sys:String>
    <sys:String x:Key="Btn_EmptyTrash">🗑 清空回收站</sys:String>

    <!-- Settings tab -->
    <sys:String x:Key="Settings_General">通用设置</sys:String>
    <sys:String x:Key="Settings_OutputDir">默认保存目录</sys:String>
    <sys:String x:Key="Settings_MaxConcurrent">最大同时下载数</sys:String>
    <sys:String x:Key="Settings_DefaultQuality">默认画质</sys:String>
    <sys:String x:Key="Quality_Option_Best">最佳画质</sys:String>
    <sys:String x:Key="Settings_AutoOpenFolder">下载完成后自动打开文件夹</sys:String>
    <sys:String x:Key="Settings_CreateSubfolders">按网站自动创建子文件夹</sys:String>
    <sys:String x:Key="Settings_Cookies">Cookie（登录态）</sys:String>
    <sys:String x:Key="Settings_CookieHint">粘贴浏览器里该站点的 document.cookie，可解锁登录后才有的高清画质。留空表示不使用。</sys:String>
    <sys:String x:Key="Settings_Network">网络设置</sys:String>
    <sys:String x:Key="Settings_EnableProxy">启用代理</sys:String>
    <sys:String x:Key="Settings_ProxyAddress">代理地址</sys:String>
    <sys:String x:Key="Settings_Player">播放设置</sys:String>
    <sys:String x:Key="Settings_UseBuiltInPlayer">使用内置播放器</sys:String>
    <sys:String x:Key="Settings_BuiltInPlayerHint">关闭则调用系统默认播放器（如 PotPlayer / MPC）</sys:String>
    <sys:String x:Key="Btn_SaveSettings">💾 保存设置</sys:String>

    <!-- Language switcher -->
    <sys:String x:Key="Language_Label">语言：</sys:String>
    <sys:String x:Key="Lang_ZhCN">中文</sys:String>
    <sys:String x:Key="Lang_ENUS">English</sys:String>

    <!-- Quick tips -->
    <sys:String x:Key="Label_SupportedSites">支持网站</sys:String>
    <sys:String x:Key="Label_QuickTips">快速提示：</sys:String>
    <sys:String x:Key="Tip_PasteUrl">- 粘贴链接后点击"获取视频信息"</sys:String>
    <sys:String x:Key="Tip_SearchTab">- 使用搜索标签页发现视频</sys:String>
    <sys:String x:Key="Tip_ClickResult">- 点击搜索结果可加载详情</sys:String>

    <!-- Status bar -->
    <sys:String x:Key="Status_Downloads">下载中：</sys:String>
    <sys:String x:Key="Status_Results">结果：</sys:String>

    <!-- Generic -->
    <sys:String x:Key="Error_Generic">错误：{0}</sys:String>

</ResourceDictionary>
